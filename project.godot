; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EDU"
config/description="Jeu d'action-parkour 2D. Édu : « course » / « pays » en ewe."
config/version="0.0.1"
run/main_scene="res://src/ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/icon.png"
boot_splash/bg_color=Color(0.93, 0.93, 0.91, 1)

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
TimeService="*res://src/autoload/time_service.gd"
SaveService="*res://src/autoload/save_service.gd"
SettingsService="*res://src/autoload/settings_service.gd"
InputService="*res://src/autoload/input_service.gd"
SceneRouter="*res://src/autoload/scene_router.gd"
ProfileService="*res://src/autoload/profile_service.gd"
AttemptService="*res://src/autoload/attempt_service.gd"
NarrativeService="*res://src/autoload/narrative_service.gd"
InventoryService="*res://src/autoload/inventory_service.gd"
MonetizationService="*res://src/autoload/monetization_service.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
